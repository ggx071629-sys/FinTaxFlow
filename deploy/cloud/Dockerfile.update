ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY --chown=10001:10001 backend/app/ /app/backend/app/
COPY --chown=10001:10001 backend/samples/ /app/backend/samples/
COPY --chown=10001:10001 frontend/portal/ /app/frontend/portal/
COPY --chown=10001:10001 deploy/cloud/update_demo_identities.py /app/deploy/update_demo_identities.py
ARG REVISION
LABEL org.opencontainers.image.revision=$REVISION org.opencontainers.image.title="FinTaxFlow explicit demo identities"
